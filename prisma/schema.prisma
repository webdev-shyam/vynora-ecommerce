// Prisma schema for Vynora Digital Affiliate Marketplace
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  image        String
  images       String[] @default([])
  price        Float
  category     String   // denormalized category name for quick filtering
  categoryId   String?  @map("category_id")
  niche        String   // e.g., Health, Finance, Business, Relationships, Fitness etc.
  affiliateUrl String   @map("affiliate_url")
  commission   Float    // percentage or fixed? store as percentage
  rating       Float    @default(4.5)
  reviewsCount Int      @default(0) @map("reviews_count")
  featured     Boolean  @default(false)
  isActive     Boolean  @default(true) @map("is_active")
  tags         String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  Category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([category])
  @@index([niche])
  @@index([featured])
  @@index([isActive])
  @@map("products")
}
